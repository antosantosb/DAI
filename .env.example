# ──────────────────────────────────────────────────────────────────────
#  PGU-TUB — Variáveis de ambiente (exemplo)
#  Copiar para .env e preencher com valores reais.
# ──────────────────────────────────────────────────────────────────────

# ─── Domínio & SSL ───
DOMAIN=pgu-tub.switzerlandnorth.cloudapp.azure.com
CERTBOT_EMAIL=admin@example.com

# ─── Data Warehouse (PostgreSQL analítico) ───
DW_USER=pgu_dw
DW_PASSWORD=CHANGE_ME
DW_NAME=pgu_datawarehouse

# ─── Tools DB (PostgreSQL partilhado para Airflow / Keycloak / Metabase) ───
TOOLS_DB_USER=tools_admin
TOOLS_DB_PASSWORD=CHANGE_ME

# ─── MongoDB (histórico bruto / audit) ───
MONGO_USER=pgu_mongo
MONGO_PASSWORD=CHANGE_ME

# ─── Keycloak ───
KEYCLOAK_DB_NAME=keycloak_db
IAM_ADMIN_USER=admin
IAM_ADMIN_PASSWORD=CHANGE_ME

# ─── Metabase ───
METABASE_DB_NAME=metabase_db

# ─── NiFi ───
NIFI_USERNAME=admin
NIFI_PASSWORD=CHANGE_ME

# ─── API Key Interna (machine-to-machine: NiFi, Simulador) ───
PGU_INTERNAL_API_KEY=CHANGE_ME

# ─── Mosquitto MQTT — credenciais por servico (Sprint -1 SEC-1) ───
# Cada user tem ACL especifica em mosquitto/config/acl.conf.
# Mosquitto falha boot se alguma destas estiver em falta.
MQTT_BACKEND_PASSWORD=CHANGE_ME
MQTT_SIMULATOR_PASSWORD=CHANGE_ME
MQTT_NIFI_PASSWORD=CHANGE_ME
MQTT_BUS_PASSWORD=CHANGE_ME

# Sprint -1 (SEC-7): nota sobre passwords do realm Keycloak
# Apenas o user "admin" vem pre-criado (password admin123, marcada como
# "temporary": true no realm JSON), forcando a mudanca no primeiro login.
# Operadores e motoristas sao criados depois pelo admin via backoffice.

# ─── MinIO (S3-compatible storage, Sprint 0 F0) ───
# Buckets exports/ attachments/ sao criados no boot pelo StorageBootstrap.
MINIO_ROOT_USER=pgu_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_EXPORTS_BUCKET=exports
MINIO_ATTACHMENTS_BUCKET=attachments
# Endpoint interno (rede Docker) e publico (browser). Defaults validos para dev local.
#MINIO_ENDPOINT=http://minio:9000
#MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ─── SMTP (Sprint 0 F0) ───
# DEV: Mailpit captura todos os emails em http://localhost:8025 (sem envio real).
#      Os defaults sao os que o pgu-setup.sh poe automaticamente.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
#
# PROD: comentar as 6 linhas acima e descomentar UMA das opcoes abaixo.
#
# Gmail (com App Password obrigatoria; 2FA tem de estar ligada na conta):
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=sistema@tub.pt
#SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#SMTP_AUTH=true
#SMTP_STARTTLS=true
#
# SendGrid (free tier 100/dia):
#SMTP_HOST=smtp.sendgrid.net
#SMTP_PORT=587
#SMTP_USERNAME=apikey
#SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxx
#SMTP_AUTH=true
#SMTP_STARTTLS=true

# ─── Alertas Críticos ───
PGU_ALERTAS_COOLDOWN=5
#PGU_ALERTAS_EMAIL=admin@example.com
PGU_ALERTAS_EMAIL_FROM=sistema@tub.pt
