# =====================================================================
# Sprint -1 (Fase 7/9) — Rate limiting zones (INFRA-nginx-rate)
# Definidas no http context (este ficheiro é includido em conf.d/).
# =====================================================================
# Zona geral da API: 20 req/s por IP, com burst de 40.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
# Zona dos endpoints de auth (login Keycloak, token refresh): mais apertada,
# 5 req/s por IP. Mitiga brute force credentials.
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;

# Redirect HTTP to HTTPS
server {
    listen 80;
    server_name ${DOMAIN};

    # Certbot ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # SSL hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # =================================================================
    # Sprint -1 (Fase 7/9) — Security headers (INFRA-nginx)
    # =================================================================
    # HSTS: forca HTTPS por 1 ano + inclui sub-domains. Comentar em dev local.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Bloqueia o site de ser embedido em iframe (clickjacking).
    add_header X-Frame-Options "DENY" always;
    # Bloqueia MIME sniffing.
    add_header X-Content-Type-Options "nosniff" always;
    # XSS protection (defensa adicional em browsers antigos).
    add_header X-XSS-Protection "1; mode=block" always;
    # Limita referrers cross-origin (privacy).
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # CSP relaxado o suficiente para React+Vite+Leaflet+Keycloak.
    # 'unsafe-inline' necessario para estilos inline do Leaflet; 'unsafe-eval'
    # necessario para Keycloak-js. ws/wss para WebSocket telemetry.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' ws: wss: https:; frame-ancestors 'none'; base-uri 'self'" always;
    # Permissions Policy: nega APIs sensíveis nao usadas.
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()" always;

    root /usr/share/nginx/html;
    index index.html;

    # ─────────────────────────────────────────
    # API (Spring Boot) — ^~ garante prioridade
    # ─────────────────────────────────────────
    location ^~ /api/ {
        # Sprint -1 (Fase 7/9): rate limit 20r/s + burst 40 (INFRA-nginx-rate)
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://spring-boot-backend:8081/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ─────────────────────────────────────────
    # WebSocket (Telemetria)
    # ─────────────────────────────────────────
    location ^~ /ws-telemetry {
        proxy_pass http://spring-boot-backend:8081/ws-telemetry;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    # ─────────────────────────────────────────
    # Keycloak (IAM)
    # ─────────────────────────────────────────
    # Keycloak (Auth) — proxy para o container interno.
    # Rate limit aplicado mas com burst alto (50) para acomodar o load
    # inicial da pagina de login que pede ~10-15 assets em paralelo.
    # O brute-force real e' protegido pelo Keycloak (lockout no realm).
    # ─────────────────────────────────────────
    location ^~ /auth/ {
        limit_req zone=auth burst=50 nodelay;
        limit_req_status 429;

        proxy_pass http://keycloak:8080/auth/;
        # $http_host inclui hostname + porta como o browser ve (ex.
        # "localhost:5443" em dev ou "pgu-tub.switzerlandnorth..." em prod).
        # KC_PROXY_HEADERS=xforwarded faz o Keycloak gerar URLs absolutas
        # a partir destes headers.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        # X-Forwarded-Port via env: 5443 em dev, 443 em prod. O nginx
        # entrypoint substitui ${EXTERNAL_PORT} via envsubst.
        proxy_set_header X-Forwarded-Port ${EXTERNAL_PORT};
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # ─────────────────────────────────────────
    # Metabase (Dashboards)
    # MB_SITE_URL já gera paths com /metabase/ prefix
    # ─────────────────────────────────────────
    location ^~ /metabase/ {
        proxy_pass http://metabase:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ─────────────────────────────────────────
    # NiFi (ETL Engine) — serve nativamente em /nifi/
    # ─────────────────────────────────────────
    location ^~ /nifi {
        proxy_pass https://nifi:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-ProxyScheme https;
        proxy_set_header X-ProxyHost ${DOMAIN};
        proxy_set_header X-ProxyPort 443;
        # Sprint -1 (SEC-13): NiFi usa cert self-signed em dev.
        # Em prod, gerar cert valido e definir proxy_ssl_trusted_certificate + on.
        proxy_ssl_verify off;
        proxy_read_timeout 600;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Airflow foi removido da stack (substituido por NiFi) — bloco
    # /airflow/ desactivado para nao quebrar o nginx com "host not found".

    # ─────────────────────────────────────────
    # MinIO (S3-compatible storage) — proxy para presigned URLs
    # Backend gera URLs assinados com MINIO_PUBLIC_ENDPOINT.
    # Em prod: MINIO_PUBLIC_ENDPOINT=https://<DOMAIN>/storage
    # A assinatura inclui o Host header, por isso preservamos $http_host.
    # ─────────────────────────────────────────
    location ^~ /storage/ {
        rewrite ^/storage/(.*)$ /$1 break;
        proxy_pass http://minio:9000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 100M;
    }

    # ─────────────────────────────────────────
    # SPA fallback (React frontend)
    # ─────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets do frontend
    location ~* ^/assets/.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
