{
  "realm": "pgu-realm",
  "enabled": true,
  "loginTheme": "pgu",
  "sslRequired": "none",
  "registrationAllowed": false,
  "internationalizationEnabled": true,
  "defaultLocale": "pt",
  "supportedLocales": ["pt"],

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpSupportedApplications": ["FreeOTP", "Google Authenticator", "Microsoft Authenticator"],

  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Atualizar Palavra-passe",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configurar Autenticador",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Atualizar Perfil",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verificar Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    }
  ],

  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access to backoffice" },
      { "name": "operador", "description": "Acesso ao backoffice - operações do dia-a-dia" },
      { "name": "motorista", "description": "Acesso ao painel de bordo do motorista" }
    ]
  },
  "clients": [
    {
      "clientId": "pgu-backoffice",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost/*", "https://pgu-tub.switzerlandnorth.cloudapp.azure.com/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost", "https://pgu-tub.switzerlandnorth.cloudapp.azure.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost/*##https://pgu-tub.switzerlandnorth.cloudapp.azure.com/*"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@pgu.local",
      "firstName": "Admin",
      "lastName": "PGU",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": true
        }
      ],
      "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
      "realmRoles": ["admin"]
    }
  ]
}
