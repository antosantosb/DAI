{
  "realm": "pgu-realm",
  "enabled": true,
  "loginTheme": "pgu",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access to backoffice" },
      { "name": "funcionario", "description": "Acesso ao backoffice — operações do dia-a-dia" }
    ]
  },
  "clients": [
    {
      "clientId": "pgu-backoffice",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost/*", "https://pgu-tub.switzerlandnorth.cloudapp.azure.com/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost", "https://pgu-tub.switzerlandnorth.cloudapp.azure.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost/*##https://pgu-tub.switzerlandnorth.cloudapp.azure.com/*"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@pgu.local",
      "firstName": "Admin",
      "lastName": "PGU",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "funcionario",
      "enabled": true,
      "email": "funcionario@pgu.local",
      "firstName": "Funcionário",
      "lastName": "PGU",
      "credentials": [
        {
          "type": "password",
          "value": "funcionario123",
          "temporary": false
        }
      ],
      "realmRoles": ["funcionario"]
    }
  ]
}
